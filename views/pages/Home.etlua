<% render(".views.components.header.Navbar_menu") %>
<main class="hero">
  <div class="hero-body">
    <div class="is-flex is-flex-wrap-wrap is-justify-content-space-evenly">
      <div class="content is-flex is-align-items-center">
        <div class="is-flex is-align-items-center conteiner-update-data">
          <div class="date-time-variables">
            <div class="dataTime">
              <strong class="">DATA:</strong>
              <span class="">15/09/2025</span>
            </div>
            <div class="dataTime">
              <strong class="">TIME:</strong>
              <span class="">12:15:10</span>
            </div>
          </div>
          <div
            class="data-variables is-justify-content-space-between is-flex is-flex-wrap-wrap" 
						id="data-variables"
          >
            <div class="data-field">
              <strong class="" id="field-1">Field-1:</strong>
              <span class="">1232454</span>
            </div>
            <div class="data-field">
              <strong class="" id="field-2">Field-2:</strong>
              <span class="">19</span>
            </div>
            <div class="data-field">
              <strong class="" id="field-3">Field-3:</strong>
              <span class="">3</span>
            </div>
            <div class="data-field">
              <strong class="" id="field-4">Field-4:</strong>
              <span class="">5</span>
            </div>
            <div class="data-field">
              <strong class="" id="field-5">Field-5:</strong>
              <span class="">2</span>
            </div>
            <div class="data-field">
              <strong class="" id="field-6">Field-6:</strong>
              <span class="">3</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      class="is-flex is-flex-wrap-wrap is-justify-content-space-evenly list-canvas"
      id="list-canvas"
    >
      <!-- <div id="list-canvas"></div> -->
    </div>
  </div>
</main>

<script src="/static/JS/chart/chart.umd.js"></script>
<script src="/static/JS/chartScript.js"></script>
<script>
const hostname = window.location.hostname;
// console.log(hostname)
// setInterval(requestDatas, 35*1000);
requestDatas()
function requestDatas(){
  fetch(`http://${hostname}:8080/<%=session.user.registration%>/fielddata`)
	.then((response) => {
		// ...
		// console.log(response.json())
		return response.json()
	})
	.then((data) => {
		// ...
		//console.log(data)
    const datatime = document.querySelectorAll(".dataTime");
    for (let i of datatime) {
      let isn = i
      // console.log(i)
			// i.querySelector("strong").textContent=""
			i.querySelector("span").textContent=""
		}
		const itens = document.querySelectorAll(".item-canvas");
		for (let i of itens) {
			i.remove()
		}

		const itens_fields = document.querySelectorAll(".data-field");
		for (let i of itens_fields) {
			i.remove();
		}
    
		let fields = data
		fields.map((fields) => {
		//	console.log(fields)
			canvas_itens(fields);
		})
		let last_field = data;
		last_field.map((last_fields) => {
      // console.log(last_fields)
      for (let itens in last_fields) {

				// console.log(last_fields[itens])
        let item = last_fields[itens]

				let name = item.name;
				let last_data = item.data[item.data.length - 1];
				// console.log(name + "\n" + last_data + "\n" + item.data.length)
        const date_time = item.column[item.column.length-1].split(" ")

          datatime[0].querySelector("span").textContent=date_time[0]
          datatime[1].querySelector("span").textContent=date_time[1]
				createLastFieldData(name, last_data)
			}
		})

	})
	.catch(function (error) {
		console.log(error);
	});
}


  // console.log(list_data)
  // const list_data = [
  //   {
  //     name: "field - 1",
  //     column: ["Red", "Blue", "Yellow", "Green", "Purple", "Orange"],
  //     data: [12, 19, 3, 5, 2, 3],
  //   },
  //   {
  //     name: "field - 2",
  //     column: ["Red", "Blue", "Yellow", "Green", "Purple", "Orange"],
  //     data: [12, 19, 3, 5, 2, 3],
  //   },
  //   {
  //     name: "field - 3",
  //     column: ["Red", "Blue", "Yellow", "Green", "Purple", "Orange"],
  //     data: [12, 19, 3, 5, 2, 3],
  //   },
  // ];
  // canvas_itens(list_data, list_data);
</script>
